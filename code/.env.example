# SAP Document AI (EU10)
DOC_AI_URL=https://eu10.doc.cloud.sap
DOC_AI_TOKEN_URL=https://<subaccount>.authentication.eu10.hana.ondemand.com/oauth/token
DOC_AI_CLIENT_ID=<client_id>
DOC_AI_CLIENT_SECRET=<client_secret>

# SAP AI Core (US10)
AI_CORE_URL=https://api.ai.prod.us-east-1.aws.ml.hana.ondemand.com/v2/inference/deployments/<deployment_id>
AI_CORE_AUTH_URL=https://<subaccount>.authentication.us10.hana.ondemand.com/oauth/token
AI_CORE_CLIENT_ID=<client_id>
AI_CORE_CLIENT_SECRET=<client_secret>

# S/4HANA
S4_ODATA_URL=https://<host>:<port>/sap/opu/odata/sap/API_SUPPLIERINVOICE_PROCESS_SRV
S4_USER=<user>
S4_PASSWORD=<password>

# SBPA (Phase C2)
SBPA_APPROVAL_URL=
NOTIFY_EMAIL=<email>
